# Dependencies
node_modules/

# Build output
# NOTE: `dist/` with a trailing slash matches ONLY a directory named exactly
# "dist". Stale or renamed output dirs (dist.stale, dist.prev, dist.bak) were
# therefore neither ignored by git nor excluded from Tailwind v4's automatic
# content detection — which scanned the previous build's CSS/JS and re-emitted
# class names found there as dead CSS. `dist.*/` closes that hole.
dist/
dist-ssr/
dist.*/

# TypeScript build cache
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment
.env
.env.local
.env.*.local

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# WorkBuddy AI project data (must not be deleted locally, but not source)
.workbuddy-ai/memory/

# Publish tooling
.verdent-*
